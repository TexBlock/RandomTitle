{
  "schemaVersion": 1,
  "id": "randomtitlerework",
  "version": "${version}",
  "name": "RandomTitleRework",
  "description": "RandomTitle unofficial 1.20.1 and above port. Pick random sentences as window title.",
  "authors": [
    "ThinkingStudio", "TexTrue", "PercyDan"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "GPLv3",
  "icon": "assets/randomtitlerework/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.thinkingstudio.randomtitlerework.fabric.RandomTitleReworkModFabricClient"
    ],
    "modmenu": [
      "org.thinkingstudio.randomtitlerework.fabric.RTRModMenuCompat"
    ]
  },
  "mixins": [
    "randomtitlerework.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
